<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="false"
    findUnusedPsalmSuppress="false"
    findUnusedCode="false"
    findUnusedVariablesAndParams="false"
    phpVersion="8.1"
    errorLevel="1"
>
    <projectFiles>
        <directory name="src"/>
        <directory name="tests"/>
        <ignoreFiles>
            <directory name="tests/Application"/>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
        <pluginClass class="Weirdan\DoctrinePsalmPlugin\Plugin"/>
    </plugins>
    <issueHandlers>
        <PluginIssue name="QueryBuilderSetParameter" errorLevel="info"/>
        <TooManyTemplateParams>
            <errorLevel type="suppress">
                <directory name="src/Factory"/> <!-- Sylius added @template annotations in later editions -->
                <directory name="src/Repository"/> <!-- Sylius added @template annotations in later editions -->
            </errorLevel>
        </TooManyTemplateParams>
        <RedundantConditionGivenDocblockType errorLevel="suppress"/>
    </issueHandlers>
    <forbiddenFunctions>
        <function name="dd"/>
        <function name="dump"/>
        <function name="echo"/>
        <function name="exit"/>
        <function name="var_dump"/>
        <function name="print_r"/>
    </forbiddenFunctions>
</psalm>
