<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="setono_sylius_google_ads.resolver.customer_ids"
                 class="Setono\SyliusGoogleAdsPlugin\Resolver\CustomerIdsResolver">
            <argument type="service" id="setono_sylius_google_ads.factory.google_ads_client"/>

            <call method="setLogger">
                <argument type="service" id="logger"/>
            </call>
        </service>

        <service id="Setono\SyliusGoogleAdsPlugin\Resolver\UserIdentifier\EmailUserIdentifierResolver">
            <tag name="setono_sylius_google_ads.user_identifier_resolver"/>
        </service>

        <service id="Setono\SyliusGoogleAdsPlugin\Resolver\CustomerCountryResolverInterface"
                 alias="Setono\SyliusGoogleAdsPlugin\Resolver\CustomerCountryResolver"/>

        <service id="Setono\SyliusGoogleAdsPlugin\Resolver\CustomerCountryResolver">
            <argument type="service" id="doctrine"/>
            <argument>%sylius.model.order.class%</argument>
        </service>

        <service id="Setono\SyliusGoogleAdsPlugin\Resolver\UserIdentifier\PhoneNumberUserIdentifierResolver">
            <argument type="service" id="Setono\SyliusGoogleAdsPlugin\Resolver\CustomerCountryResolverInterface"/>
            <tag name="setono_sylius_google_ads.user_identifier_resolver"/>
        </service>

        <service id="Setono\SyliusGoogleAdsPlugin\Resolver\UserIdentifier\UserIdentifierResolverInterface"
                 alias="Setono\SyliusGoogleAdsPlugin\Resolver\UserIdentifier\CompositeUserIdentifierResolver"/>

        <service id="Setono\SyliusGoogleAdsPlugin\Resolver\UserIdentifier\CompositeUserIdentifierResolver"/>
    </services>
</container>
